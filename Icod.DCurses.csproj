<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<Copyright>Copyright (c) 2026 Timothy J. Bruce</Copyright>
		<LangVersion>13.0</LangVersion>
		<OutputType>Library</OutputType>
		<TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<EnableDefaultCompileItems>false</EnableDefaultCompileItems>
		<AssemblyName>Icod.DCurses</AssemblyName>
		<RootNamespace>Icod.DCurses</RootNamespace>
		<Configurations>Debug;Staging;Release</Configurations>
		<Version>1.6.0</Version>
		<AssemblyVersion>1.0.0.0</AssemblyVersion>
	</PropertyGroup>
	<PropertyGroup>
		<PackageVersion>1.6.0</PackageVersion>
		<PackageId>Icod.DCurses</PackageId>
		<Title>Icod.DCurses</Title>
		<Authors>Timothy J. Bruce</Authors>
		<Description>Managed, cross-platform curses-style terminal UI library for .NET with retained text and mixed-media presentation, panels, layout, and deterministic interaction routing.</Description>
		<PackageReleaseNotes>1.6.0 adds retained mixed-media presentation over Icod.Terminal 1.15.0 persistent raster resources and Unicode placeholders. Session-owned raster resources/placeholders expose DCurses-shaped lifecycle state while opaque raster cells participate in windows, pads, viewports, editing, scrolling, copy/overlay, panels, clipping, resize, damage, synchronized refresh, and failure-safe repaint without exposing protocol-private ids or adding hidden source-image replay. The release remains additive over 1.5, keeps AssemblyVersion 1.0.0.0, targets net8.0/net9.0/net10.0, and retains direct dependencies Icod.Terminal 1.15.0 and Icod.TermInfo 1.14.0.</PackageReleaseNotes>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageIcon>icon.png</PackageIcon>
		<PackageProjectUrl>https://github.com/uniblab/Icod.DCurses</PackageProjectUrl>
		<PackageLicenseExpression>LGPL-3.0-or-later</PackageLicenseExpression>
		<PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		<PublishRepositoryUrl>true</PublishRepositoryUrl>
		<EmbedUntrackedSources>true</EmbedUntrackedSources>
		<Deterministic>true</Deterministic>
		<PackageTags>cli;command-line;console;console-ui;cross-platform;csharp;curses;dcurses;dotnet;full-screen;icod;interface;linux;macos;ncurses;pcurses;pdcurses;posix;screen;termcap;terminal;terminal-info;terminal-ui;terminfo;text;text-ui;tui;ui;user-interface;windows</PackageTags>
		<RepositoryUrl>https://github.com/uniblab/Icod.DCurses</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<GenerateAppxPackageOnBuild>false</GenerateAppxPackageOnBuild>
	</PropertyGroup>

	<PropertyGroup Condition=" '$(PlatformTarget)' == '' ">
		<PlatformTarget>AnyCPU</PlatformTarget>
	</PropertyGroup>

	<PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
		<ErrorReport>prompt</ErrorReport>
		<WarningLevel>2</WarningLevel>
		<DebugSymbols>true</DebugSymbols>
		<DebugType>portable</DebugType>
		<Optimize>false</Optimize>
		<DefineConstants>DEBUG;TRACE</DefineConstants>
		<SignAssembly>false</SignAssembly>
		<TreatWarningsAsErrors>false</TreatWarningsAsErrors>
	</PropertyGroup>

	<PropertyGroup Condition=" '$(Configuration)' == 'Staging' ">
		<ErrorReport>prompt</ErrorReport>
		<WarningLevel>4</WarningLevel>
		<DebugSymbols>true</DebugSymbols>
		<DebugType>portable</DebugType>
		<Optimize>false</Optimize>
		<DefineConstants>TRACE</DefineConstants>
		<SignAssembly>false</SignAssembly>
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
	</PropertyGroup>

	<PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
		<ErrorReport>prompt</ErrorReport>
		<WarningLevel>4</WarningLevel>
		<DebugType>portable</DebugType>
		<Optimize>true</Optimize>
		<SignAssembly>false</SignAssembly>
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
	</PropertyGroup>

	<ItemGroup>
		<Compile Include="src\**\*.cs" />
		<None Include="icon.png" Pack="true" PackagePath="" />
		<EmbeddedResource Remove="samples\**" />
		<None Remove="samples\**" />
		<EmbeddedResource Remove="tests\**" />
		<None Remove="tests\**" />
	</ItemGroup>

	<ItemGroup>
		<None Include="README.md" Pack="true" PackagePath="\" />
		<Content Include="LICENSE">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<TargetPath>$(AssemblyName).LICENSE.txt</TargetPath>
			<Pack>true</Pack>
			<PackagePath>\</PackagePath>
		</Content>
		<None Include="icod_tui_toolchain.jpg" Pack="true" PackagePath="\" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Icod.Terminal" Version="1.15.0" />
		<PackageReference Include="Icod.TermInfo" Version="1.14.0" />
	</ItemGroup>
</Project>