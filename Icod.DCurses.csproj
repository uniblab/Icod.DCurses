<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<Copyright>Copyright (c) 2026 Timothy J. Bruce</Copyright>
		<LangVersion>13.0</LangVersion>
		<OutputType>Library</OutputType>
		<TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<EnableDefaultCompileItems>false</EnableDefaultCompileItems>
		<AssemblyName>Icod.DCurses</AssemblyName>
		<RootNamespace>Icod.DCurses</RootNamespace>
		<Configurations>Debug;Staging;Release</Configurations>
		<Version>1.1.0-alpha.7</Version>
		<AssemblyVersion>1.0.0.0</AssemblyVersion>
	</PropertyGroup>
	<PropertyGroup>
		<PackageVersion>1.1.0-alpha.7</PackageVersion>
		<PackageId>Icod.DCurses</PackageId>
		<Title>Icod.DCurses</Title>
		<Authors>Timothy J. Bruce</Authors>
		<Description>Managed, cross-platform curses-like terminal UI library for .NET, built on Icod.TermInfo and Icod.Terminal.</Description>
		<PackageReleaseNotes>1.1.0-alpha.7 completes T1107 application-shaped semantic acceptance and performance/allocation review. Editor-like linked content now has acceptance coverage for wide Unicode, style changes independent of hyperlink identity, edits before and inside linked spans, and repeated semantic-only retargeting. Pager/help coverage exercises many links, settled no-op refresh, viewport movement, line insertion/deletion, and scrolling. The 2,048 x 256 reference pad validates sparse and dense semantic rows plus independent viewports. Deterministic storage evidence binds ten semantic rows to 36 KiB of reference payload versus the rejected 4 MiB unconditional inline-slot cost. Equivalent 256-cell linked runs coalesce to one bounded Terminal hyperlink transaction, while 32 distinct links remain 32 distinct semantic transactions. Real Terminal-backed tests cover synchronized output on and off, concurrent rich input, resize, suspend/resume, and deterministic protocol cleanup. Character-shift, line-shift, erase, and scrolling terminal-native shortcuts remain conservatively disabled whenever desired or retained physical semantic metadata exists because terminfo does not provide a portable guarantee that those physical operations preserve emulator-side OSC 8 cell associations. The provisional 1.1 public API remains unchanged at 45 exported types and 337 contract lines. Dependencies are Icod.Terminal 1.6.0 and Icod.TermInfo 1.10.0.</PackageReleaseNotes>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageIcon>icon.png</PackageIcon>
		<PackageProjectUrl>https://github.com/uniblab/Icod.DCurses</PackageProjectUrl>
		<PackageLicenseExpression>LGPL-3.0-or-later</PackageLicenseExpression>
		<PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		<PublishRepositoryUrl>true</PublishRepositoryUrl>
		<EmbedUntrackedSources>true</EmbedUntrackedSources>
		<Deterministic>true</Deterministic>
		<PackageTags>curses;ncurses;pcurses;dcurses;terminal;tui;console;terminfo;termcap;terminal-info;full-screen;screen;windows;linux;macos;cross-platform;dotnet;csharp;icod</PackageTags>
		<RepositoryUrl>https://github.com/uniblab/Icod.DCurses</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<GenerateAppxPackageOnBuild>false</GenerateAppxPackageOnBuild>
	</PropertyGroup>

	<PropertyGroup Condition=" '$(PlatformTarget)' == '' ">
		<PlatformTarget>AnyCPU</PlatformTarget>
	</PropertyGroup>

	<PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
		<ErrorReport>prompt</ErrorReport>
		<WarningLevel>2</WarningLevel>
		<DebugSymbols>true</DebugSymbols>
		<DebugType>portable</DebugType>
		<Optimize>false</Optimize>
		<DefineConstants>DEBUG;TRACE</DefineConstants>
		<SignAssembly>false</SignAssembly>
		<TreatWarningsAsErrors>false</TreatWarningsAsErrors>
	</PropertyGroup>

	<PropertyGroup Condition=" '$(Configuration)' == 'Staging' ">
		<ErrorReport>prompt</ErrorReport>
		<WarningLevel>4</WarningLevel>
		<DebugSymbols>true</DebugSymbols>
		<DebugType>portable</DebugType>
		<Optimize>false</Optimize>
		<DefineConstants>TRACE</DefineConstants>
		<SignAssembly>false</SignAssembly>
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
	</PropertyGroup>

	<PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
		<ErrorReport>prompt</ErrorReport>
		<WarningLevel>4</WarningLevel>
		<DebugType>portable</DebugType>
		<Optimize>true</Optimize>
		<SignAssembly>false</SignAssembly>
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
	</PropertyGroup>

	<ItemGroup>
		<Compile Include="src\**\*.cs" />
		<None Include="icon.png" Pack="true" PackagePath="" />
		<EmbeddedResource Remove="samples\**" />
		<None Remove="samples\**" />
		<EmbeddedResource Remove="tests\**" />
		<None Remove="tests\**" />
	</ItemGroup>

	<ItemGroup>
		<None Include="README.md" Pack="true" PackagePath="\" />
		<Content Include="LICENSE">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<TargetPath>$(AssemblyName).LICENSE.txt</TargetPath>
			<Pack>true</Pack>
			<PackagePath>\</PackagePath>
		</Content>
		<None Include="icod_tui_toolchain.jpg" Pack="true" PackagePath="\" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Icod.Terminal" Version="1.6.0" />
		<PackageReference Include="Icod.TermInfo" Version="1.10.0" />
	</ItemGroup>
</Project>